# Copy to .env and fill in. NEVER commit .env.

NODE_ENV=development
PORT=8080

# MongoDB (Atlas connection string, or mongodb://127.0.0.1:27017/deltacloud locally)
MONGO_URI=

# Generate each with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Must be different from each other and at least 32 characters in production.
JWT_SECRET=
REFRESH_SECRET=

# Comma-separated list of browser origins allowed to call the API.
# Capacitor apps use capacitor://localhost (iOS) and http://localhost (Android).
CLIENT_ORIGINS=http://localhost:3000,http://localhost:3001,capacitor://localhost,http://localhost,https://localhost

# Email (Brevo SMTP or any SMTP provider). Without these, codes are printed to the
# server console in development, and sign-in is refused in production.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=DeltaCloud <no-reply@yourdomain.com>

# Market data: auto = try Binance.US, fall back to clearly-labelled simulated prices
#              binance = live only | sim = simulated only
MARKET_SOURCE=auto
BINANCE_API_BASE=https://api.binance.us

# Development only: include the one-time code in API responses (ignored in production)
DEV_RETURN_OTP=false
