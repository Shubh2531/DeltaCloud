# Cloudflare Pages reads this file from the deployed site root and applies these
# headers on every response — this is what was missing. Without it, Cloudflare's
# default caching can let the browser hang onto an old sw.js (and therefore an old
# service worker, serving old cached pages) for a long time after a real deploy,
# which is why changes can look like they "aren't showing up" even though the new
# code is live. The create-react-app build copies everything in public/ as-is, so
# this file lands at the root of every deploy automatically.

# The service worker script itself must always be re-checked, or the browser can
# keep running an old one (and its old cache) indefinitely.
/sw.js
  Cache-Control: no-cache

# The app shell: always get the latest, so it always points at the latest hashed
# build files below.
/index.html
  Cache-Control: no-cache
/
  Cache-Control: no-cache
/manifest.webmanifest
  Cache-Control: no-cache

# Hashed build output (CRA puts a content hash in every filename under /static/,
# e.g. main.3f2a9c1b.js) is safe to cache forever: a new build is a new filename,
# never the same URL with different content.
/static/*
  Cache-Control: public, max-age=31536000, immutable
